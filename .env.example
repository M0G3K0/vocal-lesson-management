# ローカル開発用の環境変数の例です。
# 実際の認証情報や秘密情報は記載しないでください。
# 必要な場合は、このファイルを .env としてコピーし、起動するプロセスへ渡します。

# Backend: Spring Boot and the local PostgreSQL container
VLM_DB_URL=jdbc:postgresql://localhost:5432/vocal_lesson_management
VLM_DB_USER=vocal_lesson_management
VLM_DB_PASSWORD=local_development_only
VLM_SERVER_PORT=8080
